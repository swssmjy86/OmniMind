# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 스킬 패키징 산출물(빌드 결과물 — 소스는 각 스킬의 SKILL.md)
.claude/skills/*.zip

# Higgsfield 원본 영상 export(대용량) — 웹용 압축본만 public/videos/에 커밋한다
docs/hf_*.mp4

# iOS (Xcode/XcodeGen) — OmniMind.xcodeproj는 재현성을 위해 커밋한다
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData/
ios/.build/
